<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="<%= site.site_name %> — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.6 7.1c-1.2-1.8-3.3-2.8-5.6-2.6-2.4.2-4.1 1.6-4.1 3.4 0 4.5 9.6 2.2 9.6 6.8 0 1.9-1.8 3.4-4.2 3.6-2.5.2-4.6-.9-5.9-2.8" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="brand-word">Sama<span>Solutions</span></span>
    </a>

    <nav class="nav" aria-label="Primary">
      <div class="has-mega">
        <a class="nav-link" href="/services" aria-haspopup="true" aria-expanded="false">Services</a>
        <div class="mega" role="group" aria-label="Services menu">
          <% navCategories.forEach(function(cat){ %>
          <div class="mega-group">
            <h4><%= cat.name %></h4>
            <% cat.services.slice(0, 4).forEach(function(svc){ %>
            <a href="/services/<%= svc.slug %>"><%= svc.name %></a>
            <% }) %>
          </div>
          <% }) %>
          <div class="mega-foot">
            <span class="small">44 service lines across 10 disciplines.</span>
            <a class="link-arrow" href="/services">View all services <%- icon('arrow', 15) %></a>
          </div>
        </div>
      </div>
      <a class="nav-link <%= currentPath.startsWith('/market-area') ? 'is-active' : '' %>" href="/market-area">Market area</a>
      <a class="nav-link" href="/#work">Work</a>
      <a class="nav-link <%= currentPath.startsWith('/blog') ? 'is-active' : '' %>" href="/blog">Insights</a>
      <a class="nav-link <%= currentPath === '/about' ? 'is-active' : '' %>" href="/about">About</a>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href="tel:<%= site.contact_phone_raw %>"><span>Talk to us</span><%= site.contact_phone %></a>
      <a class="btn btn--dark btn--sm header-cta" href="/contact">Start a project</a>
      <button class="menu-toggle" type="button" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <%- icon('menu', 20) %>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu__head">
    <a class="brand" href="/" aria-label="<%= site.site_name %> — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.6 7.1c-1.2-1.8-3.3-2.8-5.6-2.6-2.4.2-4.1 1.6-4.1 3.4 0 4.5 9.6 2.2 9.6 6.8 0 1.9-1.8 3.4-4.2 3.6-2.5.2-4.6-.9-5.9-2.8" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="brand-word">Sama<span>Solutions</span></span>
    </a>
    <button class="menu-toggle" type="button" id="menuClose" aria-label="Close menu"><%- icon('close', 18) %></button>
  </div>
  <nav aria-label="Mobile">
    <a href="/services">Services</a>
    <a href="/market-area">Market area</a>
    <a href="/#work">Work</a>
    <a href="/blog">Insights</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
  </nav>
  <div class="mobile-menu__foot">
    <a href="mailto:<%= site.contact_email %>"><%= site.contact_email %></a>
    <a href="tel:<%= site.contact_phone_raw %>"><%= site.contact_phone %></a>
    <span class="small"><%= site.address %></span>
  </div>
</div>
