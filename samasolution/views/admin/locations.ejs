<div class="grid grid-4" style="margin-bottom:16px">
  <div class="stat-tile"><span>Countries</span><strong><%= summary.countries %></strong><em>Active markets</em></div>
  <div class="stat-tile"><span>States / provinces</span><strong><%= summary.states %></strong><em>Second level</em></div>
  <div class="stat-tile"><span>Cities</span><strong><%= summary.cities %></strong><em>Third level</em></div>
  <div class="stat-tile"><span>Local pages</span><strong><%= helpers.numberFmt(summary.pages) %></strong><em>Cities × services</em></div>
</div>

<details class="card" style="margin-bottom:16px">
  <summary>
    <span><strong style="font-size:14px">Add a country</strong> <span class="small muted" style="margin-left:8px">New market with its own currency, timezone and keyword roles</span></span>
    <span class="small muted">Open ▾</span>
  </summary>
  <form method="post" action="/admin/locations/country">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card__body">
      <div class="fgrid-3">
        <div class="frow"><label for="c-name">Country name</label><input class="input" id="c-name" name="name" required></div>
        <div class="frow"><label for="c-label">Display label</label><input class="input" id="c-label" name="label" placeholder="Dubai & UAE"></div>
        <div class="frow"><label for="c-code">ISO code</label><input class="input" id="c-code" name="code" maxlength="2" placeholder="AE"></div>
        <div class="frow"><label for="c-currency">Currency</label><input class="input" id="c-currency" name="currency" placeholder="AED / USD"></div>
        <div class="frow"><label for="c-tz">Time zone</label><input class="input" id="c-tz" name="timezone" placeholder="GST · UTC+4"></div>
        <div class="frow"><label for="c-overlap">Working overlap</label><input class="input" id="c-overlap" name="overlap" placeholder="1.5-hour difference from IST"></div>
        <div class="frow"><label for="c-lang">Languages</label><input class="input" id="c-lang" name="languages" placeholder="English and Arabic"></div>
        <div class="frow"><label for="c-kickoff">Kickoff time</label><input class="input" id="c-kickoff" name="kickoff" placeholder="Kickoff in 5–7 working days"></div>
        <div class="frow"><label for="c-roles">Keyword roles</label><input class="input" id="c-roles" name="roles" value="Company, Agency, Service Provider, Supplier"></div>
      </div>
      <div class="frow"><label for="c-intro">Market intro</label><textarea class="textarea" id="c-intro" name="intro" placeholder="Two or three sentences about how work is delivered here."></textarea></div>
      <div class="fgrid">
        <div class="frow"><label for="c-sort">Sort</label><input class="input" id="c-sort" name="sort" type="number" value="0"></div>
        <label class="check" style="align-self:end;margin-bottom:14px"><input type="checkbox" name="featured" checked> Feature on the market hub</label>
      </div>
    </div>
    <div class="form-foot">
      <span class="small muted">You can add states and cities after creating the country.</span>
      <button class="btn btn--sm" type="submit">Create country</button>
    </div>
  </form>
</details>

<div class="stack">
  <% countries.forEach(function(c){ %>
  <div class="card">
    <div class="card__head">
      <div>
        <h2><%= c.label || c.name %> <span class="mono" style="color:var(--faint);margin-left:6px"><%= c.code %></span></h2>
        <p><%= c.state_count %> states · <%= c.city_count %> cities · <%= c.currency || '—' %> · <%= c.timezone || '—' %></p>
      </div>
      <div style="display:flex;gap:8px">
        <a class="btn btn--ghost btn--sm" href="/market-area/<%= c.slug %>" target="_blank" rel="noopener">View</a>
        <a class="btn btn--sm" href="/admin/locations/country/<%= c.id %>">Manage</a>
      </div>
    </div>
  </div>
  <% }) %>
</div>
