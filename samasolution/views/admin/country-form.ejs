<div class="split" style="margin-bottom:16px">
  <a class="btn btn--ghost btn--sm" href="/admin/locations">← Market area</a>
  <div style="display:flex;gap:8px">
    <a class="btn btn--ghost btn--sm" href="/market-area/<%= country.slug %>" target="_blank" rel="noopener">View country page</a>
    <button class="btn btn--sm" type="submit" form="countryForm">Save country</button>
  </div>
</div>

<div class="grid grid-main">
  <div class="stack">
    <form id="countryForm" method="post" action="/admin/locations/country/<%= country.id %>" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card__head"><div><h2>Country details</h2><p>These drive the country page, city pages and keyword generation.</p></div></div>
      <div class="card__body">
        <div class="fgrid">
          <div class="frow"><label for="name">Name</label><input class="input" id="name" name="name" value="<%= country.name %>" required></div>
          <div class="frow"><label for="label">Display label</label><input class="input" id="label" name="label" value="<%= country.label %>"></div>
          <div class="frow"><label for="code">ISO code</label><input class="input" id="code" name="code" maxlength="2" value="<%= country.code %>"></div>
          <div class="frow"><label for="currency">Currency</label><input class="input" id="currency" name="currency" value="<%= country.currency %>"></div>
          <div class="frow"><label for="timezone">Time zone</label><input class="input" id="timezone" name="timezone" value="<%= country.timezone %>"></div>
          <div class="frow"><label for="overlap">Working overlap</label><input class="input" id="overlap" name="overlap" value="<%= country.overlap %>"></div>
          <div class="frow"><label for="languages">Languages</label><input class="input" id="languages" name="languages" value="<%= country.languages %>"></div>
          <div class="frow"><label for="kickoff">Kickoff</label><input class="input" id="kickoff" name="kickoff" value="<%= country.kickoff %>"></div>
          <div class="frow"><label for="sort">Sort</label><input class="input" id="sort" name="sort" type="number" value="<%= country.sort %>"></div>
          <div class="frow"><label for="roles">Keyword roles</label><input class="input" id="roles" name="roles" value="<%= roles.join(', ') %>"><p class="help">Comma separated. Used in [Service] + [Role] + [Location].</p></div>
        </div>
        <div class="frow"><label for="intro">Market intro</label><textarea class="textarea" id="intro" name="intro" style="min-height:140px"><%= country.intro %></textarea></div>
        <label class="check" style="margin-bottom:8px"><input type="checkbox" name="featured" <%= country.featured ? 'checked' : '' %>> Featured on the market hub</label>
        <label class="check"><input type="checkbox" name="active" <%= country.active ? 'checked' : '' %>> Active</label>
      </div>
      <div class="form-foot">
        <span class="small muted">Slug: <span class="mono">/market-area/<%= country.slug %></span></span>
        <button class="btn btn--sm" type="submit">Save country</button>
      </div>
    </form>

    <div class="card">
      <div class="card__head"><div><h2>States &amp; provinces</h2><p><%= states.length %> total.</p></div></div>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Name</th><th>Slug</th><th>Cities</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% states.forEach(function(s){ %>
            <tr>
              <td class="strong"><%= s.name %></td>
              <td class="mono"><%= s.slug %></td>
              <td class="num"><%= s.city_count %></td>
              <td><span class="badge badge--<%= s.active ? 'won' : 'lost' %>"><%= s.active ? 'active' : 'hidden' %></span></td>
              <td style="text-align:right"><a class="btn btn--ghost btn--sm" href="/admin/locations/state/<%= s.id %>">Manage cities</a></td>
            </tr>
            <% }) %>
            <% if (!states.length) { %><tr><td colspan="5" class="empty">No states yet — add the first one below.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <form method="post" action="/admin/locations/state">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="country_id" value="<%= country.id %>">
        <div class="form-foot" style="border-top:1px solid var(--line)">
          <input class="input" name="name" placeholder="New state or province name" style="max-width:320px" required>
          <button class="btn btn--ghost btn--sm" type="submit">Add state</button>
        </div>
      </form>
    </div>
  </div>

  <div class="stack">
    <div class="card">
      <div class="card__head"><div><h2>Preview</h2></div></div>
      <div class="card__body">
        <div class="kv">
          <dt>Label</dt><dd><%= country.label || country.name %></dd>
          <dt>Currency</dt><dd><%= country.currency %></dd>
          <dt>Time zone</dt><dd><%= country.timezone %></dd>
          <dt>Overlap</dt><dd><%= country.overlap %></dd>
          <dt>States</dt><dd><%= states.length %></dd>
          <dt>Cities</dt><dd><%= states.reduce(function(n, s){ return n + s.city_count; }, 0) %></dd>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><div><h2>Danger zone</h2></div></div>
      <div class="card__body">
        <p class="small muted" style="margin-top:0">Deleting removes every state and city beneath it, and every local page they generate.</p>
        <button class="btn btn--danger btn--sm" type="submit" form="deleteCountry">Delete country</button>
      </div>
    </div>
  </div>
</div>

<form id="deleteCountry" method="post" action="/admin/locations/country/<%= country.id %>/delete" data-confirm="Delete <%= country.name %> and all of its states and cities?">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>
