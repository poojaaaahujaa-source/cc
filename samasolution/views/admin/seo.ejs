<div class="grid grid-main">
  <div class="stack">
    <div class="card">
      <div class="card__head"><div><h2>Keyword formula</h2><p>Applied to every city × service page, and available as a bulk action.</p></div></div>
      <div class="card__body">
        <p class="mono" style="background:#f6f6f2;border:1px solid var(--line);padding:14px 16px;border-radius:6px;margin-top:0">
          [Service] + [Role] + [Location]
        </p>
        <p class="small muted">For example, a city page for website design in New Delhi, India:</p>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">
          <span class="pill pill--dark">Website Design Company New Delhi</span>
          <span class="pill pill--dark">Website Design Agency New Delhi</span>
          <span class="pill">Website Design in New Delhi</span>
          <span class="pill">Website Design Services India</span>
        </div>
        <p class="small muted" style="margin-top:16px">Roles come from each country record, so international markets use the terms buyers there actually search for.</p>
      </div>
    </div>

    <form method="post" action="/admin/seo" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card__head"><div><h2>Defaults</h2><p>Fallbacks for pages without their own meta tags.</p></div></div>
      <div class="card__body">
        <div class="frow">
          <label for="seo_default_title">Default meta title</label>
          <input class="input" id="seo_default_title" name="seo_default_title" value="<%= site.seo_default_title %>" maxlength="70" data-seo-title>
          <p class="help"><span data-count-for="seo_default_title">0</span>/70</p>
        </div>
        <div class="frow">
          <label for="seo_default_description">Default meta description</label>
          <textarea class="textarea" id="seo_default_description" name="seo_default_description" maxlength="160" data-seo-desc><%= site.seo_default_description %></textarea>
          <p class="help"><span data-count-for="seo_default_description">0</span>/160</p>
        </div>
        <div class="frow">
          <label for="seo_default_keywords">Default keywords</label>
          <textarea class="textarea" id="seo_default_keywords" name="seo_default_keywords" style="min-height:70px"><%= site.seo_default_keywords %></textarea>
        </div>
        <div class="fgrid">
          <div class="frow">
            <label for="keyword_roles">Global role pool</label>
            <input class="input" id="keyword_roles" name="keyword_roles" value="<%= site.keyword_roles %>">
            <p class="help">Comma separated. Includes Manufacturer, Importer, Exporter for product-led markets.</p>
          </div>
          <div class="frow">
            <label for="keyword_formula">Formula label</label>
            <input class="input" id="keyword_formula" name="keyword_formula" value="<%= site.keyword_formula %>">
          </div>
        </div>
      </div>
      <div class="form-foot">
        <span class="small muted">Changes apply on the next request.</span>
        <button class="btn btn--sm" type="submit">Save SEO settings</button>
      </div>
    </form>

    <div class="card">
      <div class="card__head"><div><h2>Generated pages</h2><p>What the market-area engine is producing.</p></div></div>
      <div class="card__body">
        <div class="grid grid-3">
          <div class="stat-tile"><span>City × service</span><strong><%= helpers.numberFmt(market.pages) %></strong><em>Indexable local pages</em></div>
          <div class="stat-tile"><span>City hubs</span><strong><%= helpers.numberFmt(market.cities) %></strong><em>One per city</em></div>
          <div class="stat-tile"><span>Total URLs</span><strong><%= helpers.numberFmt(totalUrls) %></strong><em>Sitemap surface</em></div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">
          <a class="btn btn--ghost btn--sm" href="/sitemap.xml" target="_blank" rel="noopener">Sitemap index</a>
          <a class="btn btn--ghost btn--sm" href="/robots.txt" target="_blank" rel="noopener">robots.txt</a>
          <a class="btn btn--ghost btn--sm" href="/llms.txt" target="_blank" rel="noopener">llms.txt</a>
        </div>
      </div>
    </div>
  </div>

  <div class="stack">
    <div class="card">
      <div class="card__head"><div><h2>Bulk generate</h2><p>Fill empty keyword fields.</p></div></div>
      <form method="post" action="/admin/seo/generate">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card__body">
          <p class="small muted" style="margin-top:0">Services missing keywords: <strong><%= missingService %></strong><br>Articles missing keywords: <strong><%= missingPost %></strong></p>
          <div class="frow">
            <label for="roles">Roles to use</label>
            <input class="input" id="roles" name="roles" value="Company, Agency, Service Provider">
          </div>
        </div>
        <div class="form-foot">
          <span class="small muted">Only fills blanks.</span>
          <button class="btn btn--sm" type="submit">Generate</button>
        </div>
      </form>
    </div>

    <div class="card">
      <div class="card__head"><div><h2>Technical checklist</h2></div></div>
      <div class="card__body">
        <div class="kv">
          <dt>Canonical</dt><dd>Per-page, absolute</dd>
          <dt>Schema</dt><dd>Organization, Service, FAQ, Article, Breadcrumb</dd>
          <dt>Open Graph</dt><dd>Title, description, image</dd>
          <dt>Robots</dt><dd>Index + AI crawlers welcome</dd>
          <dt>llms.txt</dt><dd>Citation guidance</dd>
          <dt>Sitemaps</dt><dd>Split by type, generated</dd>
          <dt>Admin</dt><dd>noindex, nofollow</dd>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><div><h2>Search Console</h2></div></div>
      <div class="card__body">
        <p class="small muted" style="margin:0">Add the verification token in Settings → Analytics, then submit <span class="mono">/sitemap.xml</span>. Generated pages are excluded from <span class="mono">lastmod</span> on purpose — only edited content carries a date.</p>
      </div>
    </div>
  </div>
</div>
