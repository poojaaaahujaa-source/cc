<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> — Sama Admin</title>
  <meta name="description" content="<%= metaDescription || 'Sama Solutions admin' %>">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
  <script nonce="<%= nonce %>" src="/js/admin.js" defer></script>
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-side">
      <a class="admin-brand" href="/admin">
        <span class="mark">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.6 7.1c-1.2-1.8-3.3-2.8-5.6-2.6-2.4.2-4.1 1.6-4.1 3.4 0 4.5 9.6 2.2 9.6 6.8 0 1.9-1.8 3.4-4.2 3.6-2.5.2-4.6-.9-5.9-2.8" stroke="#0a0a0a" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <span><b>Sama</b><small>Admin panel</small></span>
      </a>

      <p class="side-label">Workspace</p>
      <nav class="side-nav" aria-label="Admin">
        <a href="/admin" class="<%= active === 'dashboard' ? 'is-active' : '' %>"><%- icon('grid', 16) %> Dashboard</a>
        <a href="/admin/inquiries" class="<%= active === 'inquiries' ? 'is-active' : '' %>"><%- icon('mail', 16) %> Inquiries
          <% if (adminNewInquiries) { %><span class="count"><%= adminNewInquiries %></span><% } %>
        </a>
        <a href="/admin/pages" class="<%= active === 'pages' ? 'is-active' : '' %>"><%- icon('doc', 16) %> Pages</a>
        <a href="/admin/work" class="<%= active === 'work' ? 'is-active' : '' %>"><%- icon('briefcase', 16) %> Work</a>
        <a href="/admin/blog" class="<%= active === 'blog' ? 'is-active' : '' %>"><%- icon('edit', 16) %> Insights</a>
        <a href="/admin/media" class="<%= active === 'media' ? 'is-active' : '' %>"><%- icon('camera', 16) %> Media</a>
      </nav>

      <p class="side-label">Catalogue</p>
      <nav class="side-nav" aria-label="Catalogue">
        <a href="/admin/services" class="<%= active === 'services' ? 'is-active' : '' %>"><%- icon('layers', 16) %> Services</a>
        <a href="/admin/categories" class="<%= active === 'categories' ? 'is-active' : '' %>"><%- icon('folder', 16) %> Categories</a>
        <a href="/admin/locations" class="<%= active === 'locations' ? 'is-active' : '' %>"><%- icon('pin', 16) %> Market area</a>
      </nav>

      <p class="side-label">System</p>
      <nav class="side-nav" aria-label="System">
        <a href="/admin/seo" class="<%= active === 'seo' ? 'is-active' : '' %>"><%- icon('search', 16) %> SEO</a>
        <a href="/admin/settings" class="<%= active === 'settings' ? 'is-active' : '' %>"><%- icon('shield', 16) %> Settings</a>
        <a href="/admin/account" class="<%= active === 'account' ? 'is-active' : '' %>"><%- icon('users', 16) %> Account</a>
      </nav>

      <div class="side-foot">
        <div class="who">
          <b><%= admin.name %></b>
          <span><%= admin.email %></span>
        </div>
        <form action="/admin/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="logout-btn" type="submit"><%- icon('logout', 15) %> Sign out</button>
        </form>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-top">
        <div>
          <p class="crumb">Admin / <%= ({ dashboard: 'Overview', inquiries: 'Enquiries', services: 'Services', categories: 'Categories', pages: 'Pages', blog: 'Insights', work: 'Work', locations: 'Market area', media: 'Media', seo: 'SEO', settings: 'Settings', account: 'Account' })[active] || active %></p>
          <h1><%= pageTitle %></h1>
        </div>
        <div class="admin-top__actions">
          <a class="btn btn--ghost btn--sm" href="/" target="_blank" rel="noopener">View site <%- icon('arrow', 14) %></a>
        </div>
      </header>

      <main class="admin-content">
        <% if (notice) { %>
        <div class="notice <%= notice.type === 'error' ? 'notice--error' : '' %>" role="status">
          <%- icon(notice.type === 'error' ? 'close' : 'check', 16) %>
          <span><%= notice.message %></span>
        </div>
        <% } %>
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>
