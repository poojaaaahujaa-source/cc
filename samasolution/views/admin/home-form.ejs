<form method="post" action="/admin/pages/home">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="split" style="margin-bottom:16px">
    <a class="btn btn--ghost btn--sm" href="/admin/pages">← Pages</a>
    <div style="display:flex;gap:8px">
      <a class="btn btn--ghost btn--sm" href="/" target="_blank" rel="noopener">View live</a>
      <button class="btn btn--sm" type="submit">Save home page</button>
    </div>
  </div>

  <div class="grid grid-main">
    <div class="stack">
      <div class="card">
        <div class="card__head"><div><h2>Hero</h2><p>The first screen, above the image.</p></div></div>
        <div class="card__body">
          <div class="frow">
            <label for="home_eyebrow">Eyebrow</label>
            <input class="input" id="home_eyebrow" name="home_eyebrow" value="<%= site.home_eyebrow %>">
          </div>
          <div class="fgrid">
            <div class="frow">
              <label for="home_title">Headline</label>
              <input class="input" id="home_title" name="home_title" value="<%= site.home_title %>">
            </div>
            <div class="frow">
              <label for="home_title_em">Italic second line</label>
              <input class="input" id="home_title_em" name="home_title_em" value="<%= site.home_title_em %>">
            </div>
          </div>
          <div class="frow">
            <label for="home_lede">Intro paragraph</label>
            <textarea class="textarea" id="home_lede" name="home_lede"><%= site.home_lede %></textarea>
          </div>
          <div class="frow">
            <label for="home_note">Small note under the buttons</label>
            <input class="input" id="home_note" name="home_note" value="<%= site.home_note %>">
          </div>
          <div class="frow">
            <label for="home_manifesto">Studio statement</label>
            <textarea class="textarea" id="home_manifesto" name="home_manifesto"><%= site.home_manifesto %></textarea>
            <p class="help">Appears as the large statement in section 01.</p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card__head"><div><h2>Stats</h2><p>Four figures under the studio statement.</p></div></div>
        <div class="card__body">
          <% for (let i = 0; i < 4; i += 1) { const stat = stats[i] || {}; %>
          <div class="fgrid-3" style="margin-bottom:12px">
            <div class="frow"><label>Value</label><input class="input" name="stat_value_<%= i %>" value="<%= stat.value || '' %>"></div>
            <div class="frow"><label>Label</label><input class="input" name="stat_label_<%= i %>" value="<%= stat.label || '' %>"></div>
            <div class="frow"><label>Note</label><input class="input" name="stat_note_<%= i %>" value="<%= stat.note || '' %>"></div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="stack">
      <div class="card">
        <div class="card__head"><div><h2>Default SEO</h2><p>Used when a page has no override.</p></div></div>
        <div class="card__body">
          <div class="frow">
            <label for="seo_default_title">Default meta title</label>
            <input class="input" id="seo_default_title" name="seo_default_title" value="<%= site.seo_default_title %>" data-seo-title maxlength="70">
            <p class="help"><span data-count-for="seo_default_title">0</span>/70</p>
          </div>
          <div class="frow">
            <label for="seo_default_description">Default meta description</label>
            <textarea class="textarea" id="seo_default_description" name="seo_default_description" maxlength="160" data-seo-desc><%= site.seo_default_description %></textarea>
            <p class="help"><span data-count-for="seo_default_description">0</span>/160</p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card__head"><div><h2>Note</h2></div></div>
        <div class="card__body">
          <p class="small muted" style="margin:0">Services, work and insights on the home page are pulled from their own modules — no need to duplicate them here.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="split" style="margin-top:16px">
    <a class="btn btn--ghost" href="/admin/pages">Cancel</a>
    <button class="btn" type="submit">Save home page</button>
  </div>
</form>
