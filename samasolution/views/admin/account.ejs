<div class="grid grid-2">
  <div class="stack">
    <form method="post" action="/admin/account" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card__head"><div><h2>Profile</h2><p>The account you sign in with.</p></div></div>
      <div class="card__body">
        <div class="frow">
          <label for="name">Name</label>
          <input class="input" id="name" name="name" value="<%= user.name %>">
        </div>
        <div class="frow">
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" value="<%= user.email %>">
        </div>
        <div class="kv" style="margin-top:14px">
          <dt>Role</dt><dd><%= user.role %></dd>
          <dt>Created</dt><dd><%= helpers.formatDate(user.created_at, 'short') %></dd>
        </div>
      </div>
      <div class="form-foot">
        <span class="small muted">Used for admin sign-in only.</span>
        <button class="btn btn--sm" type="submit">Save profile</button>
      </div>
    </form>

    <form method="post" action="/admin/account/password" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card__head"><div><h2>Password</h2><p>At least eight characters.</p></div></div>
      <div class="card__body">
        <div class="frow">
          <label for="current">Current password</label>
          <input class="input" id="current" name="current" type="password" autocomplete="current-password" required>
        </div>
        <div class="frow">
          <label for="password">New password</label>
          <input class="input" id="password" name="password" type="password" autocomplete="new-password" required>
        </div>
        <div class="frow">
          <label for="confirm">Confirm new password</label>
          <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required>
        </div>
      </div>
      <div class="form-foot">
        <span class="small muted">Changing it signs out other sessions.</span>
        <button class="btn btn--sm" type="submit">Change password</button>
      </div>
    </form>
  </div>

  <div class="stack">
    <div class="card">
      <div class="card__head"><div><h2>Session</h2></div></div>
      <div class="card__body">
        <div class="kv">
          <dt>Signed in as</dt><dd><%= admin.name %></dd>
          <dt>Cookie</dt><dd class="mono">sama_sid</dd>
          <dt>Security</dt><dd>HttpOnly · SameSite=Lax · CSRF on every POST</dd>
          <dt>Expiry</dt><dd>7 days from sign-in</dd>
        </div>
        <form method="post" action="/admin/logout" style="margin-top:16px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><div><h2>Deployment notes</h2></div></div>
      <div class="card__body">
        <p class="small muted" style="margin-top:0">This panel runs on the same Node process as the public site and mounts at <span class="mono">/admin</span>. To isolate it, mount <span class="mono">routes/admin</span> on a separate host and restrict it by IP or SSO.</p>
        <p class="small muted" style="margin-bottom:0">Sessions live in SQLite, so a restart does not sign you out.</p>
      </div>
    </div>
  </div>
</div>
