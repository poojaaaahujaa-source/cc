<div class="split" style="margin-bottom:16px">
  <a class="btn btn--ghost btn--sm" href="/admin/inquiries">← Back to inquiries</a>
  <div style="display:flex;gap:8px">
    <a class="btn btn--ghost btn--sm" href="mailto:<%= inquiry.email %>">Reply by email</a>
    <% if (inquiry.phone) { %><a class="btn btn--ghost btn--sm" href="tel:<%= inquiry.phone %>">Call</a><% } %>
  </div>
</div>

<div class="grid grid-main">
  <div class="stack">
    <div class="card">
      <div class="card__head">
        <div>
          <h2><%= inquiry.name %></h2>
          <p><%= inquiry.company || 'Individual enquiry' %> · <%= helpers.formatDateTime(inquiry.created_at) %></p>
        </div>
        <span class="badge badge--<%= inquiry.status %>"><%= inquiry.status %></span>
      </div>
      <div class="card__body">
        <p class="message-box"><%= inquiry.message %></p>
        <div class="grid grid-3" style="margin-top:18px">
          <div>
            <div class="stat-tile" style="padding:14px">
              <span>Email</span>
              <div style="margin-top:6px;font-size:13px;word-break:break-all"><a href="mailto:<%= inquiry.email %>"><%= inquiry.email %></a></div>
            </div>
          </div>
          <div>
            <div class="stat-tile" style="padding:14px">
              <span>Phone</span>
              <div style="margin-top:6px;font-size:13px"><%= inquiry.phone || '—' %></div>
            </div>
          </div>
          <div>
            <div class="stat-tile" style="padding:14px">
              <span>Budget</span>
              <div style="margin-top:6px;font-size:13px"><%= inquiry.budget || 'Not stated' %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><div><h2>Enquiry details</h2></div></div>
      <div class="card__body">
        <dl class="kv">
          <dt>Service</dt><dd><%= inquiry.service_name || 'Not specified' %></dd>
          <dt>Country</dt><dd><%= inquiry.country || '—' %></dd>
          <dt>State</dt><dd><%= inquiry.state || '—' %></dd>
          <dt>City</dt><dd><%= inquiry.city || '—' %></dd>
          <dt>Source page</dt><dd><%= inquiry.source_path || '/contact' %></dd>
          <dt>Received</dt><dd><%= helpers.formatDateTime(inquiry.created_at) %></dd>
          <dt>Record ID</dt><dd class="mono">#<%= inquiry.id %></dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="stack">
    <div class="card">
      <div class="card__head"><div><h2>Update</h2><p>Keep the pipeline accurate.</p></div></div>
      <form method="post" action="/admin/inquiries/<%= inquiry.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card__body">
          <div class="frow">
            <label for="status">Status</label>
            <select class="select" id="status" name="status">
              <% ['new', 'contacted', 'quoted', 'won', 'lost', 'spam'].forEach(function(s){ %>
              <option value="<%= s %>" <%= inquiry.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="frow">
            <label for="notes">Internal notes</label>
            <textarea class="textarea" id="notes" name="notes" placeholder="Call outcome, next step, quote sent…"><%= inquiry.notes %></textarea>
          </div>
        </div>
        <div class="form-foot">
          <span class="small muted">Visible to the team only.</span>
          <button class="btn" type="submit">Save</button>
        </div>
      </form>
    </div>

    <div class="card">
      <div class="card__head"><div><h2>Danger zone</h2></div></div>
      <div class="card__body">
        <p class="small muted" style="margin-top:0">Deleting removes this enquiry permanently, including notes.</p>
        <form method="post" action="/admin/inquiries/<%= inquiry.id %>/delete" data-confirm="Delete this enquiry permanently?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--danger btn--sm" type="submit">Delete enquiry</button>
        </form>
      </div>
    </div>
  </div>
</div>
