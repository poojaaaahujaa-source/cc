<div class="login-shell">
  <section class="login-art">
    <div class="brandline">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.6 7.1c-1.2-1.8-3.3-2.8-5.6-2.6-2.4.2-4.1 1.6-4.1 3.4 0 4.5 9.6 2.2 9.6 6.8 0 1.9-1.8 3.4-4.2 3.6-2.5.2-4.6-.9-5.9-2.8" stroke="#0a0a0a" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </span>
      <span style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.6)">Sama Solutions</span>
    </div>
    <div>
      <h1>The studio, <em>behind the studio.</em></h1>
      <p>Pages, services, market-area locations, enquiries and SEO — all editable from one panel, without touching a template.</p>
    </div>
    <p class="foot">Delhi · Working in 7 countries</p>
  </section>

  <section class="login-panel">
    <form class="login-form" method="post" action="/admin/login">
      <h2>Sign in</h2>
      <p>Use your admin account to continue.</p>
      <% if (error) { %><div class="login-err"><%= error %></div><% } %>
      <input type="hidden" name="next" value="<%= next %>">
      <div class="frow">
        <label for="email">Email</label>
        <input class="input" type="email" id="email" name="email" autocomplete="username" required autofocus>
      </div>
      <div class="frow">
        <label for="password">Password</label>
        <input class="input" type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn" type="submit">Sign in</button>
      <div class="login-note">
        <strong>Demo account</strong><br>
        admin@samasolution.in<br>
        Sama@2026<br>
        <span style="color:var(--faint)">Change this from Account → Password after first sign-in.</span>
      </div>
    </form>
  </section>
</div>
